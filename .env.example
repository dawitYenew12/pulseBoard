# Database
DATABASE_URL="postgresql://username:password@localhost:5432/pulseBoard"

# Application
NODE_ENV="development"
PORT=5000

# JWT
JWT_SECRET=your-jwt-secret-key-here-minimum-32-characters-long
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-here-minimum-32-characters-long
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_VERIFICATION_EXPIRATION_MINUTES=15
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10

# Rate Limiting
MAX_ATTEMPTS_BY_IP_PER_DAY=500
MAX_CONSECUTIVE_FAILS_BY_EMAIL_AND_IP=10
MAX_CONSECUTIVE_FAILS_BY_EMAIL=5
API_RATE_LIMIT_WINDOW_MINUTES=10
API_RATE_LIMIT_MAX_REQUESTS=1000

# Encryption
MASTER_KEY=your-master-encryption-key-here

# CORS
CORS_ORIGIN=http://localhost:5173

# CSP (Content Security Policy) options as JSON string
CSP_OPTIONS='{"directives":{"defaultSrc":["'\''self'\''"],"scriptSrc":["'\''self'\''","https://trusted.cdn.com"],"styleSrc":["'\''self'\''","https://trusted.cdn.com"],"imgSrc":["'\''self'\''","https://images.trusted.com"],"connectSrc":["'\''self'\''"],"fontSrc":["'\''self'\''","https://fonts.googleapis.com"],"objectSrc":["'\''none'\''"]}}'

# Google OAuth Email Configuration
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_CLIENT_ID=your-google-client-id
EMAIL_CLIENT_SECRET=your-google-client-secret
EMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground
EMAIL_REFRESH_TOKEN=your-google-refresh-token

# Frontend URL
VITE_FRONTEND_URL=http://localhost:5173