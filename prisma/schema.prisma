generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// *
///  * =========================
///  * USERS
///  * =========================
model User {
  id                 String           @id @default(uuid())
  email              String           @unique
  firstName          String
  lastName           String
  role               Role             @default(EMPLOYEE)
  isVerified         Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  password           String
  githubUsername     String?          @unique
  focusSessions      FocusSession[]
  logs               Log[]
  projectsOwned      Project[]        @relation("ProjectOwner")
  projectMemberships ProjectMember[]
  refreshTokens      RefreshToken[]
  tasksAssigned      Task[]           @relation("TaskAssignee")
  tasksCreated       Task[]           @relation("TaskCreator")
  tokens             Token[]
  projectsAsMember   Project[]        @relation("ProjectMembers")
  commitActivities   CommitActivity[]
}

/// *
///  * =========================
///  * TOKENS (General tokens like verification)
///  * =========================
model Token {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  type      TokenType @default(REFRESH)
  expires   DateTime
  revoked   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// *
///  * =========================
///  * REFRESH TOKENS (Encrypted)
///  * =========================
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  iv        String
  salt      String
  authTag   String
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// *
///  * =========================
///  * PROJECTS
///  * =========================
model Project {
  id                   String          @id @default(uuid())
  name                 String
  description          String?
  pmId                 String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  githubOwner          String?
  githubRepo           String?
  githubInstallationId String?
  pm                   User?           @relation("ProjectOwner", fields: [pmId], references: [id])
  projectMembers       ProjectMember[]
  tasks                Task[]
  members              User[]          @relation("ProjectMembers")
  commitActivities     CommitActivity[]
  githubSyncLogs       GitHubSyncLog[]
}

/// *
///  * Many-to-many linking table
model ProjectMember {
  id             String       @id @default(uuid())
  projectId      String
  userId         String
  projectRole    ProjectRole  @default(MEMBER)
  githubUsername String?
  githubStatus   GitHubStatus @default(UNLINKED)
  createdAt      DateTime     @default(now())
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

/// *
///  * =========================
///  * TASKS
///  * =========================
model Task {
  id            String         @id @default(uuid())
  title         String
  description   String?
  status        TaskStatus     @default(TODO)
  priority      TaskPriority   @default(MEDIUM)
  dueDate       DateTime?
  projectId     String
  assignedTo    String?
  creatorId     String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  focusSessions FocusSession[]
  assignee      User?          @relation("TaskAssignee", fields: [assignedTo], references: [id])
  creator       User           @relation("TaskCreator", fields: [creatorId], references: [id])
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

/// *
///  * =========================
///  * FOCUS SESSIONS
///  * =========================
model FocusSession {
  id          String    @id @default(uuid())
  userId      String
  taskId      String?
  startTime   DateTime
  endTime     DateTime?
  durationMin Int?
  createdAt   DateTime  @default(now())
  task        Task?     @relation(fields: [taskId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// *
///  * =========================
///  * LOGS (Audit / Activity Log)
///  * =========================
///  *
model Log {
  id             Int      @id @default(autoincrement())
  userId         String?  @map("user_id")
  action         String   @default("other")
  entity         String?  @map("entity")
  description    String?
  userEmail      String   @map("user_email")
  userName       String   @map("user_name")
  actionReceiver String?  @map("action_receiver")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")
  endpoint       String?  @map("endpoint")
  user           User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt(sort: Desc)])
  @@index([userEmail])
  @@map("logs")
}

enum Role {
  SUPERADMIN
  PM
  EMPLOYEE
}

enum TokenType {
  REFRESH
  ACCESS
  VERIFICATION
  RESET_PASSWORD
}

enum TaskStatus {
  TODO
  PENDING_APPROVAL
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

/// *
///  * =========================
///  * PROJECT ROLE (For ProjectMember)
///  * =========================
enum ProjectRole {
  PM
  MEMBER
}

/// *
///  * =========================
///  * GITHUB STATUS (For ProjectMember)
///  * =========================
enum GitHubStatus {
  LINKED
  UNLINKED
}

/// *
///  * =========================
///  * COMMIT ACTIVITY (GitHub Contributions)
///  * =========================
///  * Stores pre-computed contribution data for heatmaps
model CommitActivity {
  id           String   @id @default(uuid())
  projectId    String
  userId       String?
  activityDate DateTime
  commitCount  Int
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId, activityDate])
  @@index([projectId])
  @@index([userId])
  @@index([activityDate])
}

/// *
///  * =========================
///  * GITHUB SYNC LOG (Optional - for debugging)
///  * =========================
///  * Helps debug sync failures for private repo access issues
model GitHubSyncLog {
  id        String   @id @default(uuid())
  projectId String
  status    String
  message   String?
  syncedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([syncedAt(sort: Desc)])
}
